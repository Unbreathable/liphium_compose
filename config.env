# BACKEND CONFIGURATION

# Domain config
BASE_PATH=localhost:3000
BASE_PORT=3000
CHAT_NODE=localhost:3001
CHAT_NODE_PORT=3001
SPACE_NODE=localhost:3002
SPACE_NODE_PORT=3002

# App config
APP_NAME=Liphium
TESTING=true
LISTEN=127.0.0.1
PROTOCOL=http://
CLI=false
SYSTEM_UUID=my_system_uuid

# Database (for the backend)
DB_USER=postgres
DB_PASSWORD=my_postgres_password
DB_DATABASE=backend
DB_HOST=database
DB_PORT=5432

# JWT
JWT_SECRET=my_jwt_secret

# Through Cloudflare Protection (or reverse proxy protection, doesn't help against man in the middle, only trusted reverse proxies)
TC_PUBLIC_KEY=my_pub_key
TC_PRIVATE_KEY=my_priv_key

# File storage folder (choose some path that exists)
ILE_REPO_TYPE=r2
FILE_REPO_KEY_ID=s3_key_id
FILE_REPO_KEY=s3_secret_key
FILE_REPO=s3_bucket_url
FILE_REPO_BUCKET=s3_bucket_name

# SMTP (for emails)
SMTP_SERVER=mail.example.com
SMTP_PORT=2587
SMTP_IDENTITY=backend
SMTP_FROM=no-reply@example.com
SMTP_USER=user
SMTP_PW=password


# CHAT NODE CONFIGURATION

# Database (for the chat node)
CN_DB_USER=postgres
CN_DB_PASSWORD=my_postgres_password
CN_DB_DATABASE=chat
CN_DB_HOST=database
CN_DB_PORT=5432

# Live share (choose some path that exists)
CN_LS_REPO=/home/julian/Documents/repo/ls

CN_ALLOW_UNSAFE=true

# SPACE STATION CONFIGURATION
SS_SFU_ENABLE=true
SS_SFU_PORT=3003
SS_SFU_DEBUG=true
SS_STUN=localhost

# TURN Server credentials
SS_TURN=localhost
SS_TURN_USERNAME=main
SS_TURN_PASSWORD=myturn123